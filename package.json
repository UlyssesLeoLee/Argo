{
  "name": "argo-desktop",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.contracts.json",
    "build:web": "tsc -p tsconfig.json",
    "dev:web": "node scripts/dev-web.mjs",
    "preview": "npm run build:web && node scripts/serve-web.mjs",
    "prepare:runtime": "node scripts/prepare-sidecar.mjs",
    "dev": "npm run prepare:runtime && npm run build:web && tauri dev",
    "build": "npm run build:web && npm run prepare:runtime -- --release && tauri build",
    "test": "npm run build:web && node --test tests/*.test.mjs",
    "test:rust": "cargo test -p argo-runtime",
    "test:integration": "python tests/integration_cluster.py",
    "check:desktop": "cargo check -p argo-desktop",
    "check:all": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "description": "Argo Tauri 2 + TypeScript UI + Rust Controller/Daemon and universal RAG"
}
