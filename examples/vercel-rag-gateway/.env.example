# Both ends must use the same >=20-char random token. Never expose it to the browser.
ARGO_RAG_API_TOKEN=put-a-random-server-to-server-secret-here
DATABASE_URL=postgresql://username:password@host/db?sslmode=require
ARGO_RAG_OWNER_ID=personal-owner
# Embedding worker is not part of this gateway version. Integrate an embedding pipeline separately.
