# Secrets must not enter Git. Generate two independent 32+ character random tokens.
ARGO_ADMIN_TOKEN=REPLACE_WITH_LONG_ADMIN_SECRET_0123456789
ARGO_WORKER_TOKEN=REPLACE_WITH_DIFFERENT_WORKER_SECRET_0123456789
ARGO_BIND=127.0.0.1:8788
ARGO_DATA_DIR=./data
ARGO_WEB_DIR=./web
ARGO_CONTROLLER_URL=http://127.0.0.1:8788
ARGO_SERVER=http://127.0.0.1:8788
ARGO_NODE_ID=windows-main
ARGO_MAX_PARALLEL=2
# JSON mapping preserves legal Windows paths containing '=' or ';'.
ARGO_REPOS_JSON={"star":"D:\\source\\Star","ide":"D:\\source\\IDE1.0"}
# REMOTE CLUSTER: supply different secrets for each node; set this only on controller.
ARGO_NODE_TOKENS_JSON={"node-a":"REPLACE_WITH_NODE_A_SECRET_123456789012","node-b":"REPLACE_WITH_NODE_B_SECRET_123456789012"}
# For PERSONAL LOOPBACK Tauri sidecar only; never enable on a remotely exposed listener.
# ARGO_ALLOW_SHARED_WORKER_TOKEN=1

# Generic server-authorized RAG profiles. Keep tokens out of JSON and the browser.
ARGO_RAG_CONNECTORS_JSON=[{"id":"personal","name":"个人知识库","upsert_url":"https://rag.example.com/api/upsert","search_url":"https://rag.example.com/api/search","token_env":"ARGO_RAG_PERSONAL_TOKEN"}]
ARGO_RAG_PERSONAL_TOKEN=REPLACE_WITH_32_CHAR_SECRET_1234567890

# Optional per-user custom OpenAI-compatible LLM gateway; never use untrusted arbitrary endpoints.
ARGO_AI_CUSTOM_CHAT_COMPLETIONS_URL=https://llm.example.com/v1/chat/completions

# STAR is currently only a custom integration contract, not an assumed existing CLI.
ARGO_STAR_DISPATCH_URL=https://star.example.com/api/argo/dispatch
ARGO_STAR_SERVICE_TOKEN=REPLACE_WITH_STAR_TOKEN_1234567890
