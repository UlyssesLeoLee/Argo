# Generate tokens independently; do not commit real tokens.
ARGO_ADMIN_TOKEN=replace-with-32-or-more-random-characters
ARGO_WORKER_TOKEN=replace-with-different-32-or-more-random-characters
ARGO_BIND=127.0.0.1:8788
ARGO_DATA_DIR=./data
# For local worker:
ARGO_SERVER=http://127.0.0.1:8788
ARGO_NODE_ID=windows-main
ARGO_MAX_PARALLEL=2
# Local trusted repo allowlist: alias=ABSOLUTE_DIRECTORY;alias2=ABSOLUTE_DIRECTORY
ARGO_REPOS=star=D:\\source\\Star;ide=D:\\source\\IDE1.0
